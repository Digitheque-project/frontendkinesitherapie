# Variables NEXT_PUBLIC_* : integrees au build (a fournir comme arguments de
# build, voir Dockerfile). Aucune valeur par defaut dans le code.

# Passerelle unique du CHU (origine seule) : backend kinesitherapie (/kine/api),
# utilisateurs (/users), prescriptions (/prescriptions), accueil (/accueil).
NEXT_PUBLIC_GATEWAY_URL=

# Page de connexion du portail CHU
NEXT_PUBLIC_LOGIN_URL=
